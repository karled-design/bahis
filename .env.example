# .env ornegi — bu dosyayi `.env` olarak kopyalayip doldurun (.env depoya girmez).

# Zorunlu
TELEGRAM_TOKEN=123456789:AAAA-bot-token
TELEGRAM_CHAT_ID=123456789
ODDS_API_KEY=the-odds-api-anahtariniz

# Istege bagli
API_FOOTBALL_KEY=
CONTEXT_FUSION_MODE=filter
CONTEXT_ENRICH_MODE=auto
HERO_MODE=false
SQE_DB_PATH=

# Operator paneli
# PANEL_HOST varsayilan olarak 127.0.0.1'dir: panele yalnizca bu bilgisayardan
# erisilir. Telefondan/uzaktan (Tailscale) erisecekseniz PANEL_HOST'u degistirin
# ve MUTLAKA PANEL_TOKEN tanimlayin (en az 16 karakter); token yoksa motor
# baslamaz. Token uretmek icin:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Uzaktan ilk acilista adres cubuguna http://<adres>:8765/?token=... yazin;
# token cereze yazilir, sonraki isteklerde tekrar gerekmez.
PANEL_HOST=127.0.0.1
PANEL_PORT=8765
PANEL_TOKEN=
